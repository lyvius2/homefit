    {
      "id": "rotation_0_same_boxes_do_not_overlap",
      "a": {
        "kind": "box",
        "x": 0,
        "y": 0,
        "width": 2000,
        "depth": 1000,
        "rotation_deg": 0
      },
      "b": {
        "kind": "box",
        "x": 0,
        "y": 1400,
        "width": 1000,
        "depth": 1000,
        "rotation_deg": 0
      },
      "expect": false
    },
    {
      "id": "rotated_90_edge_touch_is_not_intersect",
      "a": {
        "kind": "box",
        "x": 0,
        "y": 0,
        "width": 1000,
        "depth": 1000,
        "rotation_deg": 0
      },
      "b": {
        "kind": "box",
        "x": 1000,
        "y": 0,
        "width": 2000,
        "depth": 1000,
        "rotation_deg": 90
      },
      "expect": false
    },
    {
      "id": "rotated_30_vs_rotated_300_overlap",
      "a": {
        "kind": "box",
        "x": 0,
        "y": 0,
        "width": 2000,
        "depth": 400,
        "rotation_deg": 30
      },
      "b": {
        "kind": "box",
        "x": 600,
        "y": -600,
        "width": 2000,
        "depth": 400,
        "rotation_deg": 300
      },
      "expect": true
    },
    {
      "id": "wall_touching_fixture_is_not_intersect",
      "a": {
        "kind": "box",
        "x": 1000,
        "y": 500,
        "width": 1000,
        "depth": 800,
        "rotation_deg": 0
      },
      "b": { "kind": "wall", "a": [0, 0], "b": [9900, 0], "thickness_mm": 200 },
      "expect": false
    },
    {
      "id": "wall_penetrating_fixture",
      "a": {
        "kind": "box",
        "x": 1000,
        "y": 450,
        "width": 1000,
        "depth": 800,
        "rotation_deg": 0
      },
      "b": { "kind": "wall", "a": [0, 0], "b": [9900, 0], "thickness_mm": 200 },
      "expect": true
    },
    {
      "id": "fixture_beyond_wall_end_misses_extended_cap",
      "a": {
        "kind": "box",
        "x": 10600,
        "y": 0,
        "width": 1000,
        "depth": 1000,
        "rotation_deg": 0
      },
      "b": { "kind": "wall", "a": [0, 0], "b": [9900, 0], "thickness_mm": 200 },
      "expect": false
    },
    {
      "id": "fixture_hits_wall_extended_cap",
      "a": {
        "kind": "box",
        "x": 10450,
        "y": 0,
        "width": 1000,
        "depth": 1000,
        "rotation_deg": 0
      },
      "b": { "kind": "wall", "a": [0, 0], "b": [9900, 0], "thickness_mm": 200 },
      "expect": true
    },
    {
      "id": "diagonal_wall_crosses_box",
      "a": {
        "kind": "box",
        "x": 1500,
        "y": 1700,
        "width": 400,
        "depth": 400,
        "rotation_deg": 0
      },
      "b": {
        "kind": "wall",
        "a": [0, 0],
        "b": [3000, 3000],
        "thickness_mm": 200
      },
      "expect": true
    },
    {
      "id": "diagonal_wall_misses_box",
      "a": {
        "kind": "box",
        "x": 1500,
        "y": 2100,
        "width": 400,
        "depth": 400,
        "rotation_deg": 0
      },
      "b": {
        "kind": "wall",
        "a": [0, 0],
        "b": [3000, 3000],
        "thickness_mm": 200
      },
      "expect": false
    },
    {
      "id": "two_walls_meeting_at_corner",
      "a": { "kind": "wall", "a": [0, 0], "b": [9900, 0], "thickness_mm": 200 },
      "b": { "kind": "wall", "a": [0, 0], "b": [0, 6300], "thickness_mm": 200 },
      "expect": true
    }
  ]
}
