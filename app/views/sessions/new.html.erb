<% content_for :title, "로그인" %>
<section class="auth">
  <h1 class="auth__title">HomeFit</h1>
  <p class="auth__lead">도면 위에 집기를 배치해 보는 두 사람의 작업실</p>

  <%= form_with url: session_path, class: "form auth__form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "이메일" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password, "비밀번호" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <div class="form__actions">
      <%= form.submit "로그인", class: "btn btn--primary" %>
    </div>
  <% end %>
  <p class="auth__hint">계정은 관리자가 만듭니다. 비밀번호를 잊으면 콘솔에서 재설정합니다.</p>
</section>
