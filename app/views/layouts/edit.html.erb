<% content_for :title, "배치도 설정 · #{@layout.name}" %>
<div class="page-head">
  <h1>배치도 설정</h1>
  <div class="page-head__actions">
    <%= link_to "버전 기록", layout_versions_path(@layout), class: "btn btn--ghost" %>
    <%= link_to "에디터로", layout_path(@layout), class: "btn btn--ghost" %>
  </div>
</div>
<p class="muted small"><%= link_to @layout.house.name, house_path(@layout.house) %> · 최신 <%= @layout.latest_version_no ? "v#{@layout.latest_version_no}" : "버전 없음" %></p>

<section class="panel">
  <div class="panel__head"><h2>이름</h2></div>
  <%= render "form", layout: @layout %>
</section>

<section class="panel panel--danger">
  <div class="panel__head"><h2>삭제</h2></div>
  <p class="small muted">배치도를 삭제하면 저장된 버전 <%= @layout.latest_version_no.to_i %>개와 그 안의 배치가 모두 삭제됩니다. 되돌릴 수 없습니다.</p>
  <%= two_step_delete_button "배치도 삭제", layout_path(@layout) %>
</section>
