<%= form_with model: layout, url: layout.new_record? ? house_layouts_path(layout.house) : layout_path(layout), class: "form form--card" do |form| %>
  <% if layout.errors.any? %>
    <div class="form__errors">
      <strong>저장하지 못했습니다.</strong>
      <ul>
        <% layout.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="field <%= "field--invalid" if layout.errors[:name].any? %>">
    <%= form.label :name, "이름" %>
    <%= form.text_field :name, required: true, maxlength: 100, autofocus: true %>
  </div>
  <div class="form__actions">
    <%= form.submit layout.new_record? ? "배치도 만들기" : "저장", class: "btn btn--primary" %>
    <%= link_to "취소", layout.new_record? ? house_path(layout.house) : layout_path(layout), class: "btn btn--ghost" %>
  </div>
<% end %>
