<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= [ content_for(:title), "HomeFit" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="HomeFit">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# app/assets/stylesheets 의 모든 CSS %>
    <%= stylesheet_link_tag :app %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_typescript_tag "application" %>
    <%= vite_javascript_tag "islands.tsx" %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="topnav">
        <%= link_to "HomeFit", root_path, class: "topnav__brand" %>
        <nav class="topnav__links" aria-label="주 메뉴">
          <%= link_to "주택", houses_path, class: nav_link_class(houses_path) %>
          <%= link_to "집기", fixtures_path, class: nav_link_class(fixtures_path) %>
          <%= link_to "배치도", layouts_path, class: nav_link_class(layouts_path) %>
        </nav>
        <%= button_to "로그아웃", session_path, method: :delete, class: "btn btn--ghost btn--small", form_class: "topnav__logout" %>
      </header>
    <% end %>

    <main class="<%= class_names("page", yield(:page_class)) %>">
      <% if flash[:notice].present? %>
        <p class="flash flash--notice" role="status"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert].present? %>
        <p class="flash flash--alert" role="alert"><%= flash[:alert] %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
