# HomeFit 환경변수 예시. 실제 값은 .env(gitignore 대상)에 넣는다.
# DB 이름은 고정: homefit_development / homefit_test / homefit_production (config/database.yml)

# --- 외부 MySQL 8.0 접속 ---
HOMEFIT_DB_HOST=db.example.com
HOMEFIT_DB_PORT=3306
HOMEFIT_DB_USERNAME=homefit
HOMEFIT_DB_PASSWORD=change-me

# --- 접속 옵션 ---
# JDBC 옵션 ssl-mode=REQUIRED 에 대응. mysql2 gem의 ssl_mode 값: disabled | preferred | required | verify_ca | verify_identity
# (useSSL=false 는 Connector/J 전용이며 ssl-mode 가 우선하므로 생략. allowPublicKeyRetrieval=true 는
#  SSL 없이 caching_sha2_password 를 쓸 때만 필요하므로 SSL 필수 환경에서는 대응값이 없다.)
HOMEFIT_DB_SSL_MODE=required
# JDBC 옵션 serverTimezone=Asia/Seoul 에 대응. 세션 time_zone 과 앱 표시 시간대에 사용.
HOMEFIT_DB_TIMEZONE=Asia/Seoul

# --- 로그인 계정 시드 (bin/rails db:seed) ---
# "이메일:비밀번호" 를 쉼표로 구분. 이미 있는 계정은 바꾸지 않는다.
HOMEFIT_SEED_USERS=owner@example.com:change-me,partner@example.com:change-me

# --- production (docker compose) ---
# bin/rails secret 으로 만든 값. 세션 쿠키 서명에 쓰이므로 바꾸면 모두 로그아웃된다.
SECRET_KEY_BASE=change-me-run-bin-rails-secret
# 호스트에서 열 포트 (컨테이너 안은 3000 고정)
HOMEFIT_PORT=3000
# Docker Hub 이미지 이름(소문자). bin/docker-release 가 올리고 docker compose pull 이 받는다. 비우면 로컬 빌드 homefit:latest
HOMEFIT_IMAGE=docker.io/your-docker-hub-id/homefit
# 받을 태그. 보통 latest, 되돌릴 때는 커밋 short SHA (bin/docker-release 가 둘 다 올린다)
HOMEFIT_IMAGE_TAG=latest
# TLS 프록시 뒤에 둘 때만 1
HOMEFIT_FORCE_SSL=0
